{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install",
			"type": "shell",
			"command": "make install",
			"problemMatcher": []
		},
		{
			"label": "Build",
			"type": "shell",
			"command": "make BOARD=${input:board}",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "Clean",
			"type": "shell",
			"command": "make clean",
			"problemMatcher": []
		},
		{
			"label": "Rebuild",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Clean",
				"Build"
			]
		}
	],
	"inputs": [
		{
			"id": "board",
			"type": "pickString",
			"description": "Select target board",
			"options": [
				"DGNWG05LM",
				"ZHWG11LM"
			]
		}
	]
}
