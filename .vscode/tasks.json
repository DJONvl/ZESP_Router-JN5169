{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install",
			"type": "shell",
			"command": "make install",
			"problemMatcher": []
		},
		{
			"label": "Build",
			"type": "shell",
			"command": "make",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "Clean",
			"type": "shell",
			"command": "make clean",
			"problemMatcher": []
		},
		{
			"label": "Rebuild",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Clean",
				"Build"
			]
		}
	]
}
